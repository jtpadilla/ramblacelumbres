---
import Base from '../layouts/Base.astro';
import { PAGINAS, SITIO, AUTORES, LANGS, urlInicio, urlPagina, type Lang, type Alternativas } from '../site/config';
import { ui } from '../site/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const alternativas = Object.fromEntries(LANGS.map((l) => [l, urlPagina(l, 'proyecto')])) as Alternativas;

const x = {
  es: {
    titulo: 'El proyecto',
    lema: 'Cómo un blog de 2014 se ha convertido en esta guía',
    s: [
      ['Qué es', 'Ecosistema de la Rambla Celumbres es una guía fotográfica de la biodiversidad de la rambla de Celumbres, en la comarca dels Ports. Recoge íntegramente el trabajo que Francisca (Paquita) y Tadeo Julián Querol publicaron entre 2014 y 2016 en un blog de WordPress: 33 entradas y 315 fotografías.'],
      ['Qué se ha hecho en 2026', 'El blog se ha reorganizado por temas en lugar de por fechas: la rambla y sus estaciones, la flora, la fauna, los hongos y los líquenes. Las diez entradas alfabéticas de flores se han convertido en un catálogo con buscador y filtro por familias. Los textos conservan la voz de su autora; solo se han corregido erratas, acentos y nombres científicos, y se ha retocado la redacción donde hacía falta para leerse con comodidad. Todo el contenido está en castellano, valenciano, inglés y chino.'],
      ['Por qué así', 'Tadeo y Paquita ya no mantienen el blog, y un WordPress exige actualizaciones constantes. Este sitio es estático: no tiene base de datos, ni servidor que administrar, ni nada que parchear. Puede publicarse tal cual durante décadas. Tampoco tiene publicidad, ni cookies, ni recoge datos de nadie.'],
      ['Quién', `Textos: ${AUTORES.textos}. Fotografías: ${AUTORES.fotografias}. Programación, migración y contacto para correcciones: ${AUTORES.contacto}. Paquita y Tadeo son de Cinctorres, y este sitio, como su proyecto hermano santjoans.es, nace del interés desinteresado por conservar y dar a conocer el patrimonio de Cinctorres y de la comarca.`],
      ['Código y correcciones', 'El código fuente del sitio, junto con las fotografías originales y la exportación completa del blog antiguo, está publicado en GitHub. Cualquier corrección o sugerencia puede enviarse allí o directamente a Juan Tadeo Padilla Julián.'],
    ],
    hermano: 'Proyecto hermano',
    codigo: 'Código fuente en GitHub',
  },
  ca: {
    titulo: 'El projecte',
    lema: 'Com un blog de 2014 s’ha convertit en aquesta guia',
    s: [
      ['Què és', 'Ecosistema de la Rambla Celumbres és una guia fotogràfica de la biodiversitat de la rambla de Celumbres, a la comarca dels Ports. Recull íntegrament el treball que Francisca (Paquita) i Tadeo Julián Querol van publicar entre 2014 i 2016 en un blog de WordPress: 33 entrades i 315 fotografies.'],
      ['Què s’ha fet el 2026', 'El blog s’ha reorganitzat per temes en lloc de per dates: la rambla i les seues estacions, la flora, la fauna, els fongs i els líquens. Les deu entrades alfabètiques de flors s’han convertit en un catàleg amb cercador i filtre per famílies. Els textos conserven la veu de la seua autora; només s’han corregit errates, accents i noms científics, i s’ha retocat la redacció on calia per a llegir-se amb comoditat. Tot el contingut està en castellà, valencià, anglés i xinés.'],
      ['Per què així', 'Tadeo i Paquita ja no mantenen el blog, i un WordPress exigeix actualitzacions constants. Aquest lloc és estàtic: no té base de dades, ni servidor que administrar, ni res a pegar. Es pot publicar tal qual durant dècades. Tampoc té publicitat, ni galetes, ni recull dades de ningú.'],
      ['Qui', `Textos: ${AUTORES.textos}. Fotografies: ${AUTORES.fotografias}. Programació, migració i contacte per a correccions: ${AUTORES.contacto}. Paquita i Tadeo són de Cinctorres, i aquest lloc, com el seu projecte germà santjoans.es, naix de l’interés desinteressat per conservar i donar a conéixer el patrimoni de Cinctorres i de la comarca.`],
      ['Codi i correccions', 'El codi font del lloc, juntament amb les fotografies originals i l’exportació completa del blog antic, està publicat a GitHub. Qualsevol correcció o suggeriment es pot enviar allí o directament a Juan Tadeo Padilla Julián.'],
    ],
    hermano: 'Projecte germà',
    codigo: 'Codi font a GitHub',
  },
  en: {
    titulo: 'The project',
    lema: 'How a blog from 2014 became this guide',
    s: [
      ['What it is', 'Rambla Celumbres Ecosystem is a photographic guide to the biodiversity of the Celumbres rambla, in the Els Ports region of Castellón (Spain). It contains, in full, the work that Francisca (Paquita) and Tadeo Julián Querol published between 2014 and 2016 on a WordPress blog: 33 posts and 315 photographs.'],
      ['What was done in 2026', 'The blog was reorganised by subject rather than by date: the rambla and its seasons, the flora, the fauna, the fungi and the lichens. The ten alphabetical flower posts became a catalogue with a search box and a filter by family. The texts keep their author’s voice; only typos, accents and scientific names were corrected, and the wording was touched up where needed to read comfortably. Everything is available in Spanish, Valencian, English and Chinese.'],
      ['Why this way', 'Tadeo and Paquita no longer maintain the blog, and a WordPress site demands constant updates. This site is static: no database, no server to administer, nothing to patch. It can be published as is for decades. It has no advertising, no cookies, and collects nobody’s data.'],
      ['Who', `Text: ${AUTORES.textos}. Photographs: ${AUTORES.fotografias}. Programming, migration and contact for corrections: ${AUTORES.contacto}. Paquita and Tadeo are from Cinctorres, and this site, like its sister project santjoans.es, springs from a disinterested wish to preserve and make known the heritage of Cinctorres and its region.`],
      ['Code and corrections', 'The source code of the site, together with the original photographs and the complete export of the old blog, is published on GitHub. Any correction or suggestion can be sent there or directly to Juan Tadeo Padilla Julián.'],
    ],
    hermano: 'Sister project',
    codigo: 'Source code on GitHub',
  },
  zh: {
    titulo: '关于本站',
    lema: '一个 2014 年的博客如何变成了这本图鉴',
    s: [
      ['这是什么', '《塞伦布雷斯干河生态系统》是一本关于 Els Ports 地区塞伦布雷斯干河（Rambla Celumbres）生物多样性的摄影图鉴。它完整收录了 Francisca（帕基塔）和 Tadeo Julián Querol 在 2014 年至 2016 年间发表在一个 WordPress 博客上的全部作品：33 篇文章和 315 张照片。'],
      ['2026 年做了什么', '博客由按日期改为按主题编排：干河及其四季、植物、动物、真菌与地衣。原来按字母排列的十篇野花文章变成了一份带搜索和按科筛选的图录。文字保留了作者的声音：只改正了错别字、重音符号和学名，并在必要处稍作润色，以便读起来舒服。所有内容都有西班牙语、瓦伦西亚语、英语和中文版本。'],
      ['为什么这样做', '塔德奥和帕基塔已不再维护博客，而 WordPress 需要不断更新。本站是静态网站：没有数据库，没有需要管理的服务器，也没有需要打补丁的东西。它可以原样发布几十年。本站也没有广告、没有 Cookie，不收集任何人的数据。'],
      ['谁', `文字：${AUTORES.textos}。摄影：${AUTORES.fotografias}。编程、迁移及更正联系人：${AUTORES.contacto}。帕基塔和塔德奥来自 Cinctorres；本站和它的姊妹项目 santjoans.es 一样，出于保护并传播 Cinctorres 及本地区遗产的无私心愿而生。`],
      ['源代码与更正', '本站的源代码，连同原始照片和旧博客的完整导出文件，都发布在 GitHub 上。任何更正或建议都可以提交到那里，或直接联系 Juan Tadeo Padilla Julián。'],
    ],
    hermano: '姊妹项目',
    codigo: 'GitHub 上的源代码',
  },
}[lang];
---

<Base lang={lang} titulo={x.titulo} descripcion={x.lema} alternativas={alternativas}>
  <div class="lectura" style="padding-top:3.5rem">
    <p class="antetitulo"><a href={urlInicio(lang)}>{t.inicio}</a> / {PAGINAS.proyecto.nombre[lang]}</p>
    <h1 style="font-size:clamp(2.2rem,5vw,3.4rem); margin:.4rem 0 .5rem">{x.titulo}</h1>
    <p style="font-family:var(--titulos); font-style:italic; font-size:1.25rem; color:var(--tinta-2)">{x.lema}</p>
    <div class="prosa-pagina">
      {x.s.map(([h, p]) => (
        <>
          <h2>{h}</h2>
          <p set:html={p.replace('santjoans.es', `<a href="${SITIO.hermano.url}" rel="noopener">santjoans.es</a>`)} />
        </>
      ))}
      <p style="display:flex; flex-wrap:wrap; gap:.75rem; margin-top:2rem">
        <a class="boton" href={SITIO.repositorio} rel="noopener">{x.codigo}</a>
        <a class="boton boton-secundario" href={SITIO.hermano.url} rel="noopener">{x.hermano}: santjoans.es</a>
      </p>
    </div>
  </div>
</Base>
