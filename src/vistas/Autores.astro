---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { PAGINAS, SITIO, AUTORES, LANGS, urlInicio, urlPagina, urlSeccion, type Lang, type Alternativas } from '../site/config';
import { ui } from '../site/ui';
import { foto } from '../site/fotos';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const paquita = foto('2014/03/2.jpg');
const tadeo = foto('2014/03/12.jpg');
const enElCampo = foto('2014/03/27.jpg');
const rapaces = urlSeccion(lang, 'fauna') + { es: 'rapaces-diurnas/', ca: 'rapinyaires-diurns/', en: 'birds-of-prey/', zh: 'mengqin/' }[lang];
const alternativas = Object.fromEntries(LANGS.map((l) => [l, urlPagina(l, 'autores')])) as Alternativas;
const apodo = (n: string) => (lang === 'es' || lang === 'ca' ? `«${n}»` : `“${n}”`);

const x = {
  es: {
    titulo: 'Los autores',
    lema: 'Dos hermanos de Cinctorres, una cámara y un cuaderno',
    textos: 'Escribía los textos',
    fotos: 'Hacía las fotografías',
    citaPie: 'Francisca Julián Querol, en la presentación del blog original (marzo de 2014)',
    cita1: 'Mi nombre es Paquita y el de mi hermano, Tadeo. Estamos jubilados. A los dos nos gusta la naturaleza, y siempre que podemos recorremos las montañas dels Ports haciendo fotos: algunas me salen bien, otras regular; llevar al lado a un maestro de la fotografía como mi hermano es complicado. A mí me gusta más escribir, así que todo queda en casa.',
    cita2: 'El motivo de este blog es compartir su biodiversidad, nuestras fotografías y la belleza de este lugar, desconocido para muchos y entrañable para nosotros, pues lo conocemos bien por las correrías que hemos hecho por él desde nuestra infancia.',
    fotoPie: 'Paquita en la rambla, con la Roca Roja al fondo.',
    h1: 'Quiénes son',
    p1: 'Francisca (Paquita) y Tadeo Julián Querol nacieron en Cinctorres y conocen la rambla de Celumbres desde niños. Entre 2014 y 2016, ya jubilados, recorrieron una y otra vez los bancales de l’Arribassada, la fuente dels Bassis, los pinares de la Roca Parda y los montes comunales de la comarca. Ella identificaba y describía lo que encontraban; él lo fotografiaba. El resultado fueron 33 entradas y más de trescientas fotografías en un blog que llamaron «Ecosistema de la Rambla Celumbres».',
    p2: 'Para las fotos de los buitres pasaron varias mañanas agazapados en lo alto del acantilado bajo una malla de camuflaje. Para las de la Graellsia isabellae madrugaron hasta encontrarla a las siete, recién llovido, y la fotografiaron sobre la mano de Tadeo antes de que el sol la despertara. Ese es el espíritu de todo el trabajo: paciencia, cariño por el lugar y ganas de que otros lo conozcan.',
    h2: 'Por qué existe este sitio',
    p3: 'El blog original era un WordPress que Tadeo y Paquita ya no mantienen. En 2026 la familia lo ha convertido en esta guía: los mismos textos —con las erratas corregidas y la redacción apenas retocada, para que siga sonando a ellos—, las mismas fotografías, reordenadas por temas y traducidas al valenciano, al inglés y al chino, en un sitio estático que no necesita servidor ni mantenimiento y que podrá seguir consultándose durante muchos años.',
    p4: 'Es un homenaje a su trabajo y, sobre todo, una forma de que el patrimonio natural de Cinctorres y de la comarca dels Ports siga a la vista de quien quiera mirarlo.',
    h3: 'El proyecto hermano',
    p5: 'Tadeo y Paquita participaron también en santjoans.es, el visor del pavimento cerámico zoo-mórfico del Palau Santjoans de Cinctorres: ella con el estudio del pavimento y él con la fotografía de las piezas. Es un proyecto con la misma vocación que este, documentar y difundir lo que Cinctorres tiene de valioso.',
    p6: 'La programación de ambos sitios y el contacto para cualquier corrección es de Juan Tadeo Padilla Julián.',
    proyecto: 'Más sobre cómo se ha hecho este sitio',
    verRapaces: 'Leer la guía de las rapaces',
  },
  ca: {
    titulo: 'Els autors',
    lema: 'Dos germans de Cinctorres, una càmera i un quadern',
    textos: 'Escrivia els textos',
    fotos: 'Feia les fotografies',
    citaPie: 'Francisca Julián Querol, en la presentació del blog original (març de 2014)',
    cita1: 'Em dic Paquita i el meu germà, Tadeo. Estem jubilats. A tots dos ens agrada la natura, i sempre que podem recorrem les muntanyes dels Ports fent fotos: algunes m’ixen bé, altres regular; portar al costat un mestre de la fotografia com el meu germà és complicat. A mi m’agrada més escriure, així que tot queda a casa.',
    cita2: 'El motiu d’aquest blog és compartir la seua biodiversitat, les nostres fotografies i la bellesa d’aquest lloc, desconegut per a molts i entranyable per a nosaltres, perquè el coneixem bé per les correries que hi hem fet des de la infantesa.',
    fotoPie: 'Paquita a la rambla, amb la Roca Roja al fons.',
    h1: 'Qui són',
    p1: 'Francisca (Paquita) i Tadeo Julián Querol van nàixer a Cinctorres i coneixen la rambla de Celumbres des de xiquets. Entre 2014 i 2016, ja jubilats, van recórrer una vegada i una altra els bancals de l’Arribassada, la font dels Bassis, les pinedes de la Roca Parda i els monts comunals de la comarca. Ella identificava i descrivia el que trobaven; ell ho fotografiava. El resultat van ser 33 entrades i més de tres-centes fotografies en un blog que van anomenar «Ecosistema de la Rambla Celumbres».',
    p2: 'Per a les fotos dels voltors van passar diversos matins ajupits a dalt del penya-segat sota una malla de camuflatge. Per a les de la Graellsia isabellae van matinar fins a trobar-la a les set, acabat de ploure, i la van fotografiar sobre la mà de Tadeo abans que el sol la despertara. Aquest és l’esperit de tot el treball: paciència, estima pel lloc i ganes que altres el coneguen.',
    h2: 'Per què existeix aquest lloc',
    p3: 'El blog original era un WordPress que Tadeo i Paquita ja no mantenen. El 2026 la família l’ha convertit en aquesta guia: els mateixos textos —amb les errates corregides i la redacció a penes retocada, perquè continue sonant a ells—, les mateixes fotografies, reordenades per temes i traduïdes al valencià, a l’anglés i al xinés, en un lloc estàtic que no necessita servidor ni manteniment i que es podrà continuar consultant durant molts anys.',
    p4: 'És un homenatge al seu treball i, sobretot, una manera que el patrimoni natural de Cinctorres i de la comarca dels Ports continue a la vista de qui vulga mirar-lo.',
    h3: 'El projecte germà',
    p5: 'Tadeo i Paquita van participar també en santjoans.es, el visor del paviment ceràmic zoomòrfic del Palau Santjoans de Cinctorres: ella amb l’estudi del paviment i ell amb la fotografia de les peces. És un projecte amb la mateixa vocació que aquest, documentar i difondre allò que Cinctorres té de valuós.',
    p6: 'La programació dels dos llocs i el contacte per a qualsevol correcció és de Juan Tadeo Padilla Julián.',
    proyecto: 'Més sobre com s’ha fet aquest lloc',
    verRapaces: 'Llegir la guia dels rapinyaires',
  },
  en: {
    titulo: 'The authors',
    lema: 'Two siblings from Cinctorres, a camera and a notebook',
    textos: 'Wrote the texts',
    fotos: 'Took the photographs',
    citaPie: 'Francisca Julián Querol, introducing the original blog (March 2014)',
    cita1: 'My name is Paquita and my brother’s is Tadeo. We are retired. We both love nature, and whenever we can we walk the Els Ports mountains taking photographs: some of mine come out well, others so-so; having a master photographer like my brother beside you makes it complicated. I prefer writing, so it all stays in the family.',
    cita2: 'The purpose of this blog is to share the biodiversity, our photographs and the beauty of this place, unknown to many and dear to us, for we know it well from the rambles we have made through it since childhood.',
    fotoPie: 'Paquita in the rambla, with the Roca Roja behind.',
    h1: 'Who they are',
    p1: 'Francisca (Paquita) and Tadeo Julián Querol were born in Cinctorres and have known the Celumbres rambla since they were children. Between 2014 and 2016, after retiring, they walked again and again the terraces of l’Arribassada, the dels Bassis spring, the pine woods of the Roca Parda and the common woodlands of the region. She identified and described what they found; he photographed it. The result was 33 posts and more than three hundred photographs on a blog they called “Ecosistema de la Rambla Celumbres”.',
    p2: 'For the vulture photographs they spent several mornings crouched at the top of the cliff under a camouflage net. For the Graellsia isabellae they rose early until they found it at seven, just after the rain, and photographed it on Tadeo’s hand before the sun woke it. That is the spirit of the whole work: patience, love for the place and a wish for others to know it.',
    h2: 'Why this site exists',
    p3: 'The original blog was a WordPress site that Tadeo and Paquita no longer maintain. In 2026 the family turned it into this guide: the same texts —with typos corrected and the wording only lightly touched, so they still sound like her—, the same photographs, reorganised by subject and translated into Valencian, English and Chinese, on a static site that needs neither a server nor maintenance and that can go on being read for many years.',
    p4: 'It is a tribute to their work and, above all, a way of keeping the natural heritage of Cinctorres and the Els Ports region in view of anyone who cares to look.',
    h3: 'The sister project',
    p5: 'Tadeo and Paquita also took part in santjoans.es, the viewer of the zoomorphic ceramic pavement of the Palau Santjoans in Cinctorres: she with the study of the pavement and he with the photography of the tiles. It is a project with the same purpose as this one: to document and share what is valuable in Cinctorres.',
    p6: 'The programming of both sites, and the contact for any correction, is Juan Tadeo Padilla Julián.',
    proyecto: 'More about how this site was made',
    verRapaces: 'Read the birds of prey guide',
  },
  zh: {
    titulo: '作者',
    lema: 'Cinctorres 的一对姐弟、一台相机和一本笔记本',
    textos: '撰写文字',
    fotos: '拍摄照片',
    citaPie: 'Francisca Julián Querol，原博客的开篇介绍（2014 年 3 月）',
    cita1: '我叫帕基塔（Paquita），我的弟弟叫塔德奥（Tadeo）。我们都退休了。我们俩都喜欢大自然，只要有空就去 Els Ports 山区走走、拍拍照：我拍的有些还不错，有些一般；身边有一位像我弟弟这样的摄影大师，并不容易。我更喜欢写东西，所以一切都留在家里。',
    cita2: '写这个博客，是为了分享这里的生物多样性、我们的照片，以及这个地方的美——它不为很多人所知，却是我们心里最亲切的地方，因为从小时候起，我们就在这里跑来跑去，对它再熟悉不过了。',
    fotoPie: '帕基塔在干河里，背后是 Roca Roja。',
    h1: '他们是谁',
    p1: 'Francisca（帕基塔）和 Tadeo Julián Querol 出生于 Cinctorres，从小就熟悉塞伦布雷斯干河。2014 年到 2016 年间，退休后的两人一次又一次走过 l’Arribassada 的梯田、dels Bassis 泉、Roca Parda 的松林和本地区的公共山林。她辨认并描述所见之物，他负责拍照。成果是一个名为《Ecosistema de la Rambla Celumbres》的博客：33 篇文章，三百多张照片。',
    p2: '为了拍兀鹫，他们好几个早晨蹲在悬崖顶上的伪装网下。为了拍西班牙月蛾（Graellsia isabellae），他们一早起床，七点钟在雨后找到了它，趁太阳还没把它唤醒，把它放在塔德奥的手上拍了下来。这就是整个工作的精神：耐心、对这片土地的热爱，以及希望更多人认识它的心愿。',
    h2: '为什么有这个网站',
    p3: '原来的博客是一个 WordPress 站点，塔德奥和帕基塔已不再维护。2026 年，家人把它做成了这本图鉴：同样的文字——只改正了错别字、几乎不动措辞，好让它读起来仍然是她的声音——同样的照片，按主题重新编排，并译成了瓦伦西亚语、英语和中文，放在一个不需要服务器、不需要维护、可以在很多年里一直查阅的静态网站上。',
    p4: '这是对他们工作的致敬，更是一种让 Cinctorres 和 Els Ports 地区的自然遗产继续呈现在任何愿意看一眼的人面前的方式。',
    h3: '姊妹项目',
    p5: '塔德奥和帕基塔也参与了 santjoans.es——Cinctorres 的 Palau Santjoans 宫动物纹样陶瓷地砖的浏览网站：她负责地砖的研究，他负责拍摄每一块砖。那个项目与这个项目志向相同：记录并传播 Cinctorres 的珍贵之物。',
    p6: '两个网站的编程工作，以及任何更正的联系人，是 Juan Tadeo Padilla Julián。',
    proyecto: '更多关于本站是如何做成的',
    verRapaces: '阅读猛禽篇',
  },
}[lang];
---

<Base lang={lang} titulo={x.titulo} descripcion={x.lema} imagen={enElCampo.src} alternativas={alternativas} activo="autores">
  <div class="contenedor">
    <div class="lectura" style="text-align:center; padding-top:3.5rem">
      <p class="antetitulo"><a href={urlInicio(lang)}>{t.inicio}</a> / {PAGINAS.autores.nombre[lang]}</p>
      <h1 style="font-size:clamp(2.2rem,5vw,3.6rem); margin:.4rem 0 .5rem">{x.titulo}</h1>
      <p class="lema" style="font-family:var(--titulos); font-style:italic; font-size:1.25rem; color:var(--tinta-2)">{x.lema}</p>
    </div>

    <div class="autores-cabecera" style="padding-top:1.5rem">
      <div class="autor">
        <Image src={paquita} alt="Francisca Julián Querol" width={480} height={480} loading="eager" />
        <h2>Francisca Julián Querol</h2>
        <p>{apodo('Paquita')}</p>
        <p class="antetitulo">{x.textos}</p>
      </div>
      <div class="autor">
        <Image src={tadeo} alt="Tadeo Julián Querol" width={480} height={480} loading="eager" />
        <h2>Tadeo Julián Querol</h2>
        <p>{apodo('Tadeo')}</p>
        <p class="antetitulo">{x.fotos}</p>
      </div>
    </div>

    <blockquote class="cita lectura">
      <p>{x.cita1}</p>
      <p>{x.cita2}</p>
      <footer>— {x.citaPie}</footer>
    </blockquote>

    <figure class="foto-ancha">
      <Image src={enElCampo} alt={x.fotoPie} widths={[640, 1024, 1600]} sizes="(max-width: 78rem) 100vw, 78rem" loading="lazy" />
      <figcaption>{x.fotoPie}</figcaption>
    </figure>

    <div class="lectura prosa-pagina">
      <h2>{x.h1}</h2>
      <p>{x.p1}</p>
      <p>{x.p2} <a href={rapaces}>{x.verRapaces} →</a></p>
      <h2>{x.h2}</h2>
      <p>{x.p3}</p>
      <p>{x.p4}</p>
      <h2>{x.h3}</h2>
      <p set:html={x.p5.replace('santjoans.es', `<a href="${SITIO.hermano.url}" rel="noopener">santjoans.es</a>`)} />
      <p>{x.p6}</p>
      <p><a class="boton" href={urlPagina(lang, 'proyecto')}>{x.proyecto}</a></p>
    </div>
  </div>
</Base>
