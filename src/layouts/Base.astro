---
import { Font } from 'astro:assets';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO, LANGS, LANG_POR_DEFECTO, CODIGO_IDIOMA, urlRss, urlPublico, type Lang, type Alternativas } from '../site/config';
import { ui } from '../site/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  titulo?: string;
  descripcion?: string;
  /** URL absoluta o relativa de la imagen para redes */
  imagen?: string;
  tipo?: 'website' | 'article';
  fecha?: Date;
  /** misma pagina en cada idioma (incluido el actual) */
  alternativas?: Alternativas;
  /** seccion activa en el menu */
  activo?: string;
}

const { lang, titulo, descripcion = SITIO.descripcion[lang], imagen, tipo = 'website', fecha, alternativas, activo } = Astro.props;
const t = ui(lang);
const tituloCompleto = titulo ? `${titulo} · ${SITIO.titulo[lang]}` : SITIO.titulo[lang];
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = imagen ? new URL(imagen, Astro.site).href : undefined;

---

<!doctype html>
<html lang={CODIGO_IDIOMA[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    {alternativas && LANGS.map((l) => <link rel="alternate" hreflang={CODIGO_IDIOMA[l]} href={new URL(alternativas[l], Astro.site).href} />)}
    {alternativas && <link rel="alternate" hreflang="x-default" href={new URL(alternativas[LANG_POR_DEFECTO], Astro.site).href} />}
    <link rel="icon" href={urlPublico('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.titulo[lang]} href={urlRss(lang)} />
    <link rel="sitemap" href={urlPublico('sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15180f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.titulo[lang]} />
    <meta property="og:title" content={titulo ?? SITIO.titulo[lang]} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:locale" content={SITIO.locale[lang].replace('-', '_')} />
    {imagenAbs && <meta property="og:image" content={imagenAbs} />}
    {fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
    <meta name="twitter:card" content={imagenAbs ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--fuente-titulos" preload />
    <Font cssVariable="--fuente-texto" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    <Cabecera lang={lang} alternativas={alternativas} activo={activo} />
    <main id="contenido">
      <slot />
    </main>
    <Pie lang={lang} alternativas={alternativas} />
  </body>
</html>
