---
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO } from '../site';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  tipo?: 'website' | 'article';
  fecha?: Date;
}

const {
  titulo,
  descripcion = SITIO.descripcion,
  imagen,
  tipo = 'website',
  fecha,
} = Astro.props;

const tituloCompleto = titulo ? `${titulo} · ${SITIO.titulo}` : SITIO.titulo;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = imagen ? new URL(imagen, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITIO.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.titulo} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.titulo} />
    <meta property="og:title" content={titulo ?? SITIO.titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:locale" content="es_ES" />
    {imagenAbs && <meta property="og:image" content={imagenAbs} />}
    {fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
    <meta name="twitter:card" content={imagenAbs ? 'summary_large_image' : 'summary'} />

    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
