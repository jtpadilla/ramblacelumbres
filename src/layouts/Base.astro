---
import { Font } from 'astro:assets';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import { SITIO, type Lang } from '../site/config';
import { ui } from '../site/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  titulo?: string;
  descripcion?: string;
  /** URL absoluta o relativa de la imagen para redes */
  imagen?: string;
  tipo?: 'website' | 'article';
  fecha?: Date;
  /** misma pagina en el otro idioma */
  alternativa?: string;
  /** seccion activa en el menu */
  activo?: string;
}

const { lang, titulo, descripcion = SITIO.descripcion[lang], imagen, tipo = 'website', fecha, alternativa, activo } = Astro.props;
const t = ui(lang);
const tituloCompleto = titulo ? `${titulo} · ${SITIO.titulo[lang]}` : SITIO.titulo[lang];
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = imagen ? new URL(imagen, Astro.site).href : undefined;
const alternativaAbs = alternativa ? new URL(alternativa, Astro.site).href : undefined;
const otro = lang === 'es' ? 'ca' : 'es';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica.href} />
    {alternativaAbs && <link rel="alternate" hreflang={otro} href={alternativaAbs} />}
    {alternativaAbs && <link rel="alternate" hreflang={lang} href={canonica.href} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITIO.titulo[lang]} href={lang === 'es' ? '/rss.xml' : '/ca/rss.xml'} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4efe4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15180f" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITIO.titulo[lang]} />
    <meta property="og:title" content={titulo ?? SITIO.titulo[lang]} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica.href} />
    <meta property="og:locale" content={SITIO.locale[lang].replace('-', '_')} />
    {imagenAbs && <meta property="og:image" content={imagenAbs} />}
    {fecha && <meta property="article:published_time" content={fecha.toISOString()} />}
    <meta name="twitter:card" content={imagenAbs ? 'summary_large_image' : 'summary'} />

    <Font cssVariable="--fuente-titulos" preload />
    <Font cssVariable="--fuente-texto" preload />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">{t.saltar}</a>
    <Cabecera lang={lang} alternativa={alternativa} activo={activo} />
    <main id="contenido">
      <slot />
    </main>
    <Pie lang={lang} alternativa={alternativa} />
  </body>
</html>
