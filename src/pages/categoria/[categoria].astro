---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';
import { nombreCategoria } from '../../site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const entradas = await getCollection('posts');
  const slugs = new Set(entradas.flatMap((e) => e.data.categories));
  return [...slugs].map((slug) => ({
    params: { categoria: slug },
    props: {
      slug,
      entradas: entradas
        .filter((e) => e.data.categories.includes(slug))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}) satisfies GetStaticPaths;

const { slug, entradas } = Astro.props;
const nombre = nombreCategoria(slug);
---

<Base
  titulo={nombre}
  descripcion={`Entradas sobre ${nombre.toLowerCase()} en la rambla de Celumbres.`}
>
  <div class="contenedor">
    <div class="entradilla">
      <p class="meta"><a href="/blog/">Todas las entradas</a></p>
      <h1>{nombre}</h1>
      <p class="meta">{entradas.length} {entradas.length === 1 ? 'entrada' : 'entradas'}</p>
    </div>
    <ul class="rejilla">
      {entradas.map((e, i) => <Tarjeta entrada={e} destacada={i < 3} />)}
    </ul>
  </div>
</Base>
