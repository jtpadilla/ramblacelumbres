---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tarjeta from '../../components/Tarjeta.astro';

const entradas = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// agrupadas por ano de publicacion
const porAnio = new Map<number, typeof entradas>();
for (const e of entradas) {
  const a = e.data.date.getFullYear();
  porAnio.set(a, [...(porAnio.get(a) ?? []), e]);
}
const anios = [...porAnio.keys()].sort((a, b) => b - a);
---

<Base titulo="Todas las entradas" descripcion="Archivo completo del blog de la Rambla Celumbres, de 2014 a 2016.">
  <div class="contenedor">
    <div class="entradilla">
      <h1>Todas las entradas</h1>
      <p class="meta">{entradas.length} publicaciones</p>
    </div>
    {anios.map((anio) => (
      <>
        <h2 class="titulo-seccion">{anio}</h2>
        <ul class="rejilla">
          {porAnio.get(anio)!.map((e) => <Tarjeta entrada={e} />)}
        </ul>
      </>
    ))}
  </div>
</Base>
