---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import { SITIO, nombreCategoria } from '../site';
import portada from '../assets/uploads/2015/03/1.jpg';
import redirecciones from '../data/redirects.json';

const entradas = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recientes = entradas.slice(0, 6);

const porCategoria = new Map<string, number>();
for (const e of entradas) {
  for (const c of e.data.categories) porCategoria.set(c, (porCategoria.get(c) ?? 0) + 1);
}
const categorias = [...porCategoria.entries()].sort((a, b) => b[1] - a[1]);
---

<Base descripcion={SITIO.descripcion} imagen={portada.src}>
  <script slot="head" is:inline define:vars={{ redirecciones }}>
    // Los enlaces del WordPress antiguo eran ?p=123, ?page_id=23 y ?cat=4.
    // Un alojamiento estatico ignora la query y sirve esta portada, asi que la
    // traducimos aqui a la direccion nueva antes de pintar nada.
    if (location.search) {
      const destino = redirecciones['/' + location.search];
      if (destino) location.replace(destino);
    }
  </script>

  <div class="portada">
    <div class="foto">
      <Image
        src={portada}
        alt="Panorámica de la rambla de Celumbres en primavera, con viboreras en flor y bancales de piedra al fondo"
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="velo"></div>
      <div class="texto">
        <div class="contenedor">
          <h1>{SITIO.titulo}</h1>
          <p>{SITIO.lema}, en las montañas dels Ports.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="lectura intro">
    <p>
      Un recorrido fotográfico por la biodiversidad de la rambla: flores silvestres, insectos,
      líquenes, aves y mamíferos, más el paisaje que cambia con las estaciones.
    </p>
    <p class="meta">{entradas.length} entradas publicadas entre 2014 y 2016</p>
  </div>

  <div class="contenedor">
    <h2 class="titulo-seccion">Explorar por categoría</h2>
    <ul class="etiquetas">
      {categorias.map(([slug, n]) => (
        <li><a href={`/categoria/${slug}/`}>{nombreCategoria(slug)} <span class="meta">({n})</span></a></li>
      ))}
    </ul>

    <h2 class="titulo-seccion">Últimas entradas</h2>
    <ul class="rejilla">
      {recientes.map((e, i) => <Tarjeta entrada={e} destacada={i < 3} />)}
    </ul>

    <p style="margin-top:2rem"><a href="/blog/">Ver las {entradas.length} entradas →</a></p>
  </div>
</Base>
