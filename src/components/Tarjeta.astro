---
import { Image } from 'astro:assets';
import { SECCIONES, type Lang } from '../site/config';
import { urlDe, type Guia } from '../site/guias';

interface Props { guia: Guia; prioridad?: boolean; conGrupo?: boolean }
const { guia, prioridad = false, conGrupo = false } = Astro.props;
const { title, subtitle, summary, cover, coverAlt, section, group } = guia.data;
const lang = guia.data.lang as Lang;
const grupo = group ? SECCIONES[section].grupos[group]?.[lang] : undefined;
---

<li class="tarjeta">
  <a href={urlDe(guia)} tabindex="-1" aria-hidden="true">
    <Image src={cover} alt="" widths={[360, 640, 960]} sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 24rem" loading={prioridad ? 'eager' : 'lazy'} />
  </a>
  <div class="tarjeta-cuerpo">
    {conGrupo && grupo && <span class="antetitulo">{grupo}</span>}
    <h3><a href={urlDe(guia)}>{title}</a></h3>
    {subtitle && <p class="subtitulo">{subtitle}</p>}
    <p>{summary}</p>
  </div>
</li>
